# Copy this file to .env and fill in your values.

PORT=3000

# --- Google Sheets ---
# 1. Create a Google Sheet (e.g. "BraveEve Pilot Responses").
# 2. Add a tab named "responses" (or change GOOGLE_SHEET_TAB below).
# 3. Create a Google Cloud service account with the Sheets API enabled,
#    download its JSON key, and share the Sheet with the service
#    account's email address (Editor access).
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=responses
# Either point to the downloaded key file...
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# ...or paste the whole JSON key as one line (useful for hosting platforms
# that don't let you upload files, e.g. Render/Railway/Vercel env vars).
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# --- NLP sidecar (Python) ---
NLP_SIDECAR_URL=http://127.0.0.1:5001
